# --- AI (optional: unset = deterministic template mode) ---
# ANTHROPIC_API_KEY=sk-ant-...
# PROPOS_LLM_MODEL=claude-sonnet-5

# --- OneMap (geocoding is keyless; walking routes & amenity layers need a
#     free account from onemap.gov.sg) ---
# ONEMAP_EMAIL=you@example.com
# ONEMAP_PASSWORD=...
# or a pre-issued token:
# ONEMAP_TOKEN=...

# --- Server ---
# PORT=3000
# PROPOS_DATA_DIR=./data
