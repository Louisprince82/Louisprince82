# Viral Content Engine — required credentials
# In n8n, store each of these as a credential; never commit real values.

# Stage 2 — EXTRACT
APIFY_TOKEN=            # apify.com → Settings → Integrations. Actor: clockworks/tiktok-scraper
OPENAI_API_KEY=         # Whisper transcription (whisper-1)

# Stages 3-5 — Agents A/B/C
ANTHROPIC_API_KEY=      # Claude Sonnet for deconstruction, scripting, B-roll tagging

# Stage 6 — SOURCE (B-roll)
PEXELS_API_KEY=         # free — pexels.com/api (generic_business class)
PIXABAY_API_KEY=        # free — pixabay.com/api/docs (tech_abstract class)
ARTGRID_SESSION=        # cinematic_hero class — Artgrid has no public API; download hero shots manually into library/broll
KLING_ACCESS_KEY=       # impossible class — text_to_video
KLING_SECRET_KEY=

# Stage 7 — VOICE
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=    # your cloned voice

# Stage 8 — ASSEMBLE
JSON2VIDEO_API_KEY=     # json2video.com — the volume render lane
SUBMAGIC_NOTE=          # Submagic is the manual fast lane; no API wiring needed

# Stage 9 — DISTRIBUTE
METRICOOL_API_TOKEN=
METRICOOL_BLOG_ID=      # your Metricool brand id

# Approval gate + logging
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_SHEETS_LOG_ID=   # spreadsheet id for the iteration log
